# TDLib for Nullgram: libtdjson in /usr/lib/nullgram (Nullgram's own, beside no other TDLib), at the commit
# Nullgram's calls are checked against (1.8.68). OpenSSL is linked in statically (3.5 LTS, built here): one
# package for phones with OpenSSL 3 and those with 4. Heavy (TDLib wants ~4 GB of memory): built by CI.
pkgname=nullgram-tdlib
pkgver=1.8.68
pkgrel=1
_tdcommit=175048b69616ebc81b59ce71aa42abedbab9fe54
_ossl=3.5.9
pkgdesc="TDLib (Telegram Database library) for Nullgram"
arch=('aarch64' 'x86_64')
url="https://github.com/tdlib/td"
license=('BSL-1.0' 'Apache-2.0')
depends=('zlib' 'gcc-libs' 'glibc')
makedepends=('git' 'cmake' 'gperf' 'perl')
source=("td::git+https://github.com/tdlib/td.git#commit=$_tdcommit"
        "https://github.com/openssl/openssl/releases/download/openssl-$_ossl/openssl-$_ossl.tar.gz")
sha256sums=('SKIP'
            '603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a')

build() {
	cd "$srcdir/openssl-$_ossl"
	./Configure no-shared no-tests no-docs --prefix="$srcdir/ossl" --libdir=lib
	make -j"$(nproc)"
	make install_sw
	cmake -S "$srcdir/td" -B "$srcdir/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
		-DOPENSSL_ROOT_DIR="$srcdir/ossl" -DOPENSSL_USE_STATIC_LIBS=ON -DTD_ENABLE_LTO=OFF
	cmake --build "$srcdir/build" --target tdjson -j"${NULLGRAM_TD_JOBS:-2}"
}

package() {
	install -d "$pkgdir/usr/lib/nullgram"
	cp -P "$srcdir/build"/libtdjson.so* "$pkgdir/usr/lib/nullgram/"
	install -Dm644 "$srcdir/td/LICENSE_1_0.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE_1_0.txt"
}
