#!/bin/sh
# Nullgram from a package (/usr/share/nullgram). One at a time: a second start brings the running one
# back (SIGUSR1 shows a hidden window), a checkout's run too (python3 <dir>/nullgram.py: both would open one
# TDLib database; its picture helpers run as /usr/bin/python3 and do not count). Its words go to
# $XDG_RUNTIME_DIR/nullgram.log.
pid=$(pgrep -f '^python3 [^ ]*/nullgram\.py( |$)' | head -1)
[ -n "$pid" ] && { kill -USR1 "$pid"; exit 0; }
export QT_QPA_PLATFORM=${QT_QPA_PLATFORM:-wayland} QT_FORCE_STDERR_LOGGING=1
log=${XDG_RUNTIME_DIR:-/tmp}/nullgram.log
setsid -f python3 /usr/share/nullgram/nullgram.py "$@" > "$log" 2>&1 < /dev/null
